{
  "name": "trace",
  "private": true,
  "scripts": {
    "dev": "echo 'Run dev:service and dev:dashboard in separate terminals' && exit 0",
    "dev:service": "tsx packages/service/src/index.ts",
    "dev:dashboard": "cd packages/dashboard && npx vite",
    "build": "pnpm -r run build",
    "build:dashboard": "cd packages/dashboard && npx vite build",
    "build:menubar": "cd menubar/Trace && swift build",
    "test": "vitest",
    "lint": "eslint packages/",
    "format": "prettier --write 'packages/**/*.{ts,tsx}'"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "tsx": "^4.23.1"
  }
}
