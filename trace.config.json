  "screenshotDir": "~/Desktop",
  "screenshotExtensions": [".png", ".jpg", ".jpeg"],
  "browserHistoryPollIntervalMs": 120000,
  "browserHistoryDebounceMs": 1500,
  "browserHistoryInitialLookbackHours": 0,
