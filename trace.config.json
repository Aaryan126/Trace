  "checkpointQuietSeconds": 25,
  "synthesisMinItems": 2,
  "clusteringConfidenceThreshold": 0.6,
  "resurfacingDigestWindowDays": 7,
  "dashboardPort": 3333,
  "openai": {
    "model": "gpt-5.6-terra",
    "visionModel": "gpt-5.6-terra",
    "checkpointModel": "gpt-5.6-sol"
  },
  "db": {
    "path": "~/.trace/trace.sqlite"
  }
}
