{
  "manifest_version": 3,
  "name": "Trace Browser Capture",
  "version": "1.1.0",
  "description": "Adds visible research context to your local Trace decision history.",
  "key": "",
  "permissions": ["tabs", "scripting", "webNavigation", "nativeMessaging", "alarms"],
  "host_permissions": ["<all_urls>"],
  "externally_connectable": {
    "matches": ["http://127.0.0.1:3333/*", "http://localhost:3333/*"]
  },
  "incognito": "not_allowed",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Capture this research page in Trace"
  }
}
